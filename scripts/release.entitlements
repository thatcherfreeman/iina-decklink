<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    The hardened runtime (required for notarization) enforces library
    validation by default: a process may only load code signed by the same
    Team ID as itself, or by Apple. decklink_shim.cpp dlopens
    DeckLinkAPI.framework at runtime (see DeckLinkAPIDispatch.cpp) — that
    framework is Blackmagic Design's, a different Team ID, so without this
    entitlement a signed-and-notarized helper would pass notarization but
    then fail to find any DeckLink device at runtime. Ported from
    youtube-decklink's packaging/release.entitlements, which hit the same
    issue for the same reason.
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
