# Copy this file to release.env and fill in your own values.
# release.env is gitignored so your signing identity never gets committed —
# it stays purely local, never touches GitHub (Actions, secrets, or the repo).

# CODESIGN_IDENTITY is your "Developer ID Application" certificate's common
# name.  List what you have with:  security find-identity -v -p codesigning
CODESIGN_IDENTITY = Developer ID Application: FIRSTNAME LASTNAME (TEAMID)

# NOTARY_PROFILE is the name of a notarytool credential profile stored in your
# keychain (not in this file).  Create it once — the password is an
# app-specific password from appleid.apple.com, not your Apple ID password:
#
#   xcrun notarytool store-credentials "iina-decklink-notary" \
#       --apple-id you@example.com --team-id TEAMID --password abcd-efgh-ijkl-mnop
NOTARY_PROFILE = iina-decklink-notary
